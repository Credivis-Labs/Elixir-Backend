# Copy to .env for local dev. NEVER commit .env.
NODE_ENV=development
LOG_LEVEL=info

DATABASE_URL=postgres://elixir:elixir@localhost:5432/elixir

# Stellar
STELLAR_NETWORK=testnet
SOROBAN_RPC_URL=http://localhost:8000/soroban/rpc
HORIZON_URL=http://localhost:8000

# Relayer. Comma-separated S... secrets for channel accounts.
# Local dev only — production loads these from a secret manager (docs/SECURITY.md).
RELAYER_CHANNEL_SECRETS=
RELAYER_FEE_SOURCE_SECRET=
